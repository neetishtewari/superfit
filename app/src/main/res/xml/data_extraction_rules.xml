<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12 (API 31) and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   Old Gemini API keys (see GeminiKeyStore, which deletes them) are never uploaded to cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="superfit_secrets.xml" />
    </cloud-backup>
</data-extraction-rules>
